{
  // Cloudflare deploy config for the Trophy Bingo site.
  // Static assets served straight from the repo root, plus a small Worker
  // (worker.js) for the members sign-up. No build step.
  //   Production (main branch):    bunx wrangler deploy
  //   Staging    (staging branch): bunx wrangler deploy --env staging
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trophy-bingo",
  "main": "worker.js",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "observability": { "enabled": true },
  // trophybingo.com is the home. The other three hostnames only 301 to it
  // (worker.js redirectTarget): www.trophybingo.com keeps the path,
  // greenstone.games/trophybingo/x goes to trophybingo.com/x.
  "routes": [
    { "pattern": "trophybingo.com", "custom_domain": true },
    { "pattern": "www.trophybingo.com", "custom_domain": true },
    { "pattern": "greenstone.games", "custom_domain": true },
    { "pattern": "www.greenstone.games", "custom_domain": true }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // The Worker sees every request so it can redirect by hostname.
    "run_worker_first": true
  },
  "kv_namespaces": [
    { "binding": "MEMBERS", "id": "029e857837064be4825858090d363272" }
  ],
  "env": {
    // Staging: its own Worker on workers.dev only. No custom domains, so a
    // staging deploy can never touch trophybingo.com. Every response gets
    // noindex, and sign-ups land in a separate staging store.
    "staging": {
      "name": "trophy-bingo-staging",
      "workers_dev": true,
      "routes": [],
      "vars": { "STAGING": "1" },
      "assets": {
        "directory": ".",
        "binding": "ASSETS",
        "run_worker_first": true
      },
      "kv_namespaces": [
        { "binding": "MEMBERS", "id": "1787aa19beb14e2f8e9442795a2e5703" }
      ]
    }
  }
}
