# Files in the repo that should NOT be served as part of the website.
# Workers Builds clones the repo, so .git and .wrangler must be listed:
# they are NOT skipped automatically.
.git
.git/*
.wrangler
.wrangler/*
.github
.github/*
node_modules
node_modules/*
bun.lock
bun.lockb
package-lock.json
.assetsignore
.gitignore
.gitattributes
CLAUDE.md
README.md
wrangler.jsonc
wrangler.toml
*.md
worker.js
